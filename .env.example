# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
NOTION_VERSION=2026-03-11

# Cloudflare
R2_BUCKET=comapeo-content
D1_DATABASE_NAME=comapeo-content-pipeline
QUEUE_NAME=comapeo-content-sync

# Pipeline
DEFAULT_LOCALES=en,pt,es
DEFAULT_STATUS_FILTER=active
MAX_PAGES_PER_CRON=50
MAX_NOTION_RPS=3
MANIFEST_KEY=manifests/latest.json

# Admin
ADMIN_TOKEN=

# Translation LLM (OpenAI-compatible chat completions API)
#
# Provider is auto-detected from the credentials below. Credentials and endpoints
# resolve in atomic provider groups (OpenAI, DeepSeek, Poolside) to prevent
# transmitting credentials across provider boundaries. CLI flags and generic
# TRANSLATION_* variables override provider defaults across all providers.
#
# API key precedence:
#   TRANSLATION_API_KEY > OPENAI_API_KEY > DEEPSEEK_API_KEY > POOLSIDE_API_KEY
#
# Provider defaults (applied when that provider's key is selected):
#   OpenAI    https://api.openai.com/v1         gpt-4o                  (production)
#   DeepSeek  https://api.deepseek.com/v1       deepseek-chat           (production)
#   Poolside  https://inference.poolside.ai/v1  poolside/laguna-s-2.1   (testing)
#
# Generic overrides (highest precedence)
# TRANSLATION_API_KEY=
# TRANSLATION_BASE_URL=
# TRANSLATION_MODEL=

# OpenAI (production)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# DeepSeek (production)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Poolside (testing only; keys with the sky_ prefix auto-select Poolside)
POOLSIDE_API_KEY=
