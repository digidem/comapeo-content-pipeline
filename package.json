{
  "name": "comapeo-content-pipeline",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "pipeline": "bun src/cli/index.ts",
    "translations:missing": "bun scripts/missing-translations.ts --all",
    "translations:generate": "bun scripts/translate-missing.ts",
    "translations:report": "bun scripts/translation-report-html.ts",
    "translations:check": "bun scripts/translation-report-html.ts --open",
    "docs:post-editorial": "bun scripts/post-editorial-guide.ts --apply",
    "validate:mdx": "node --experimental-strip-types scripts/validate-mdx.ts",
    "gate:verify": "bun scripts/verify-pr-gate.ts"
  },
  "dependencies": {
    "@notionhq/client": "^5.12.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.10.4",
    "sharp": "^0.34.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260609.1",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.0",
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.72.0"
  }
}
